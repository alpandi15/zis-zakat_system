# ---------------------------------------------------------------------------
# Salin berkas ini menjadi .env lalu isi dengan kredensial proyek Supabase Anda.
#   cp .env.example .env
#
# Berkas .env sudah masuk .gitignore, jadi tidak akan ikut ter-commit.
# JANGAN pernah menaruh service_role key di sini: nilai NEXT_PUBLIC_* terbaca
# oleh browser.
# ---------------------------------------------------------------------------

# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > publishable / anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Identitas lembaga, dipakai pada kop laporan PDF/Excel dan papan /tv
NEXT_PUBLIC_MASJID_NAME=
NEXT_PUBLIC_MASJID_ADDRESS=
